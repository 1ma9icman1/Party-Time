rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['userId', 'playerName', 'score', 'updatedAt']) &&
             data.keys().size() == 4 &&
             data.userId == request.auth.uid &&
             data.playerName is string && data.playerName.size() <= 64 &&
             data.score is number &&
             data.updatedAt == request.time;
    }

    match /leaderboards/{entryId} {
      allow read: if true; // Public leaderboard
      allow create: if isSignedIn() && isValidId(entryId) && isValidLeaderboardEntry(incoming());
      allow update: if isSignedIn() && isValidId(entryId) &&
        isValidLeaderboardEntry(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().score >= existing().score; // Only update if score is higher
    }

    function isValidUserProgress(data) {
      return data.keys().hasAll(['userId', 'maxLevelUnlocked', 'stars', 'updatedAt']) &&
             data.keys().size() == 4 &&
             data.userId == request.auth.uid &&
             data.maxLevelUnlocked is number &&
             data.updatedAt == request.time; // Simplified stars map validation (in real app we'd validate map structure strictly, but firestore rules are limited for maps. We assume client sends correct map)
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUserProgress(incoming());
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && 
        isValidUserProgress(incoming()) &&
        incoming().userId == existing().userId;
    }
  }
}
